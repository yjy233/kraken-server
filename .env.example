APP_TITLE=Kraken Agent
HOST=0.0.0.0
PORT=3011
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=qwen/qwen3.6-plus
TAVILY_API_KEY=replace_me
MAX_TOKENS=65500
MAX_CONTEXT_TOKENS=65500
MAX_CONTEXT_MESSAGES=128
MAX_AGENT_STEPS=64
REQUEST_TIMEOUT_MS=120000
ALLOW_SHELL_TOOL=true
ALLOW_FILE_WRITE_TOOL=true
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MS=300000
SCHEDULER_MAX_CONCURRENCY=1
# 支持绝对路径或 ~/...；未设置时默认使用 ~/kraken/skills
KRAKEN_SKILLS_DIR=/Users/bill/code/kraken-server/skills
ALLOW_AGENT_BROWSER=true
AGENT_BROWSER_BIN=agent-browser
AGENT_BROWSER_MAX_OUTPUT=50000
AGENT_BROWSER_DEFAULT_TIMEOUT=25000
# Empty or * means no domain allowlist. Use comma-separated domains to restrict browsing.
AGENT_BROWSER_ALLOWED_DOMAINS=*
# Optional auth-state reuse. Pick one strategy:
# AGENT_BROWSER_PROFILE=Default              # Reuse a Chrome profile such as Default or Profile 1.
# AGENT_BROWSER_AUTO_CONNECT=true            # Connect to an already-running Chrome with remote debugging.
# AGENT_BROWSER_SESSION_NAME=kraken          # Auto-save/restore cookies and localStorage by name.
# AGENT_BROWSER_STATE=/absolute/auth.json    # Load cookies and storage from a saved agent-browser state file.

FEISHU_ENABLED=false
FEISHU_EVENT_MODE=ws
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_SESSION_MODE=chat
FEISHU_REPLY_MODE=reply
FEISHU_DEFAULT_SYSTEM_PROMPT=
FEISHU_CHANNEL_SKILL=dingtakl-feishu-cn
FEISHU_MAX_CONCURRENCY=1
FEISHU_DEDUPE_TTL_MS=600000
FEISHU_INCLUDE_MESSAGE_META=true
FEISHU_STREAMING_ENABLED=false
FEISHU_STREAMING_MODE=update
FEISHU_STREAMING_FLUSH_INTERVAL_MS=1500
FEISHU_STREAMING_MIN_DELTA_CHARS=80
FEISHU_STREAMING_MAX_UPDATES=20

ENABLED_TOOLS=list_directory,read_file,grep,glob,write_file,shell_command,web_fetch,agent_browser,todo,search,replace,skill,skill_install
