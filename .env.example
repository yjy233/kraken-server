APP_TITLE=Kraken Agent
HOST=127.0.0.1
PORT=3011
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=anthropic/claude-sonnet-4
TAVILY_API_KEY=replace_me
DEFAULT_SYSTEM_PROMPT=You are Kraken Agent, a pragmatic engineering agent. Work in iterations, use tools when needed, and finish with a direct answer.
MAX_TOKENS=2048
MAX_CONTEXT_MESSAGES=24
MAX_AGENT_STEPS=8
REQUEST_TIMEOUT_MS=120000
ALLOW_SHELL_TOOL=true
ALLOW_FILE_WRITE_TOOL=false
ENABLED_TOOLS=list_directory,read_file,grep,glob,todo,search,web_fetch,replace
