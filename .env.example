APP_TITLE=Kraken Agent
HOST=0.0.0.0
PORT=3011
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace_me
# Model chat/completions requests do not use a proxy.
# Use NANO_BANANA_PROXY below for nano-banana-pro image generation only.
# Adds one OpenRouter cache_control breakpoint for providers that require explicit prompt caching.
OPENROUTER_PROMPT_CACHE=true
OPENROUTER_PROMPT_CACHE_TYPE=ephemeral
# Optional for nano-banana-pro skill when local proxy is needed for OpenRouter requests.
NANO_BANANA_PROXY=http://127.0.0.1:7897
OPENROUTER_MODEL=qwen/qwen3.6-plus
TAVILY_API_KEY=replace_me
MAX_TOKENS=65500
MAX_CONTEXT_TOKENS=65500
MAX_CONTEXT_MESSAGES=128
MAX_AGENT_STEPS=64
REQUEST_TIMEOUT_MS=120000
ALLOW_SHELL_TOOL=true
ALLOW_FILE_WRITE_TOOL=true
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_MS=300000
SCHEDULER_MAX_CONCURRENCY=1
# 支持绝对路径或 ~/...；未设置时默认使用 ~/kraken/skills
KRAKEN_SKILLS_DIR=/Users/bill/code/kraken-server/skills
ALLOW_AGENT_BROWSER=true
AGENT_BROWSER_BIN=agent-browser
AGENT_BROWSER_MAX_OUTPUT=50000
AGENT_BROWSER_DEFAULT_TIMEOUT=25000
# Empty or * means no domain allowlist. Use comma-separated domains to restrict browsing.
AGENT_BROWSER_ALLOWED_DOMAINS=*
# Optional auth-state reuse. Pick one strategy:
# AGENT_BROWSER_PROFILE=Default              # Reuse a Chrome profile such as Default or Profile 1.
# AGENT_BROWSER_AUTO_CONNECT=true            # Connect to an already-running Chrome with remote debugging.
# AGENT_BROWSER_SESSION_NAME=kraken          # Auto-save/restore cookies and localStorage by name.
# AGENT_BROWSER_STATE=/absolute/auth.json    # Load cookies and storage from a saved agent-browser state file.
# Feishu robot channel
# Enable Feishu self-built app bot integration.
FEISHU_ENABLED=false
# Event transport. Current production path is ws (long connection).
FEISHU_EVENT_MODE=ws
# Required when FEISHU_ENABLED=true.
FEISHU_APP_ID=
# Required when FEISHU_ENABLED=true.
FEISHU_APP_SECRET=
# Only used for HTTP callback mode. Not required for ws mode.
FEISHU_VERIFICATION_TOKEN=
# Reserved for Feishu encrypted callback payloads. Not required for ws mode.
FEISHU_ENCRYPT_KEY=
# chat: one Kraken session per group chat. user: split group sessions by sender.
FEISHU_SESSION_MODE=chat
# reply: reply to the source message. send: send a new message into the chat.
FEISHU_REPLY_MODE=reply
# Optional per-channel base system prompt override for Feishu-originated sessions.
FEISHU_DEFAULT_SYSTEM_PROMPT=
# Preferred skill hint injected by the Feishu channel prompt.
FEISHU_CHANNEL_SKILL=dingtakl-feishu-cn
# Max Feishu message jobs processed concurrently.
FEISHU_MAX_CONCURRENCY=1
# How long a Feishu event/message dedupe key is kept, in milliseconds.
FEISHU_DEDUPE_TTL_MS=600000
# Persist Feishu message metadata such as message_id/chat_id/sender_id into session messages.
FEISHU_INCLUDE_MESSAGE_META=true
# Enable quasi-streaming reply updates in Feishu.
FEISHU_STREAMING_ENABLED=false
# none: final reply only. update: send placeholder then update the same reply progressively.
FEISHU_STREAMING_MODE=update
# Minimum interval between Feishu streaming updates, in milliseconds.
FEISHU_STREAMING_FLUSH_INTERVAL_MS=1500
# Minimum newly accumulated characters before sending another partial update.
FEISHU_STREAMING_MIN_DELTA_CHARS=80
# Maximum number of intermediate streaming updates per reply.
FEISHU_STREAMING_MAX_UPDATES=20

ENABLED_TOOLS=list_directory,read_file,grep,glob,write_file,shell_command,web_fetch,agent_browser,todo,search,replace,skill,skill_install
