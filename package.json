{
  "name": "kraken-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:fe": "esbuild src/frontend/main.tsx --bundle --outfile=public/app.js --format=esm --jsx=automatic --watch",
    "build": "npm run build:server && npm run build:fe",
    "build:server": "tsc -p tsconfig.json",
    "build:fe": "esbuild src/frontend/main.tsx --bundle --outfile=public/app.js --format=esm --jsx=automatic --minify",
    "start": "FEISHU_APP_ID=xxx FEISHU_APP_SECRET=xxx node dist/server.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "ai": "^6.0.168",
    "express": "^5.1.0",
    "marked": "^18.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
